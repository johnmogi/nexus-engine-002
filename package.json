{
  "name": "nexus-dm-poker-tool",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Seedable dungeon-master utility. Elemental poker cards generate rooms, monsters, traps, loot, and small maps.",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "build": "tsc --noEmit && vite build",
    "generate": "tsx src/cli.ts generate",
    "map": "tsx src/cli.ts map"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
